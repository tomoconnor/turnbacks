# Turnbacks configuration. Copy to .env and edit.
#
# Both compose files read this file: compose.prod.yaml uses all of it;
# compose.yaml uses the app settings and its own ports (it overrides the
# environment, database, address and admin CA for development).
#
# Secret values can instead be read from a file by appending _FILE, e.g.
# TURNBACKS_SLACK_SIGNING_SECRET_FILE=/run/secrets/slack-signing-secret.

# --- Core --------------------------------------------------------------------
# production | development | test. Development-only features (loopback admin,
# demo seed data) are refused unless this is development or test.
TURNBACKS_ENV=production
TURNBACKS_HTTP_ADDR=:8080
# Public base URL (used for same-origin checks). Optional; compose.prod.yaml
# derives it from TURNBACKS_HOST.
TURNBACKS_PUBLIC_URL=https://turnbacks.example.com
# Used by compose.prod.yaml; set TURNBACKS_DATABASE_URL directly otherwise.
POSTGRES_USER=turnbacks
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=turnbacks
# TURNBACKS_DATABASE_URL=postgres://turnbacks:secret@db.internal:5432/turnbacks?sslmode=require
# TURNBACKS_DATABASE_URL_FILE=/run/secrets/turnbacks-database-url
TURNBACKS_DB_MAX_CONNS=10
# How long to wait for the database at start-up before giving up.
TURNBACKS_DB_WAIT=60s
TURNBACKS_MIGRATE_ON_START=true

# --- Logging & HTTP ------------------------------------------------------------
TURNBACKS_LOG_LEVEL=info
TURNBACKS_LOG_FORMAT=json
TURNBACKS_REQUEST_TIMEOUT=30s
# State-changing API requests one person (SSO user or address) may make per
# minute, per replica; administrators are exempt. 0 disables the limit.
TURNBACKS_WRITE_RATE_LIMIT=60
TURNBACKS_SHUTDOWN_TIMEOUT=20s
# Comma-separated CIDRs/addresses of reverse proxies whose X-Forwarded-For is
# trusted. IMPORTANT: reports are attributed to the client address (one VPN
# address = one person). Behind a proxy or ingress, set this to the proxy's
# address range or every report will appear to come from the proxy.
# Not needed with compose.prod.yaml: Caddy connects over a Unix socket
# (TURNBACKS_HTTP_ADDR=unix:/path), and socket peers are always trusted.
TURNBACKS_TRUSTED_PROXIES=

# --- Administration ------------------------------------------------------------
# Anyone who can reach Turnbacks can record and read reports (there are no user
# accounts). Administration (settings, rates, teams, merging and editing
# problems, remediations, correcting reports, webhooks and the audit views)
# requires a TLS client certificate from the Turnbacks admin CA (see
# docs/admin-certificates.md) or, with single sign-on, an admin user or group
# (see Identity below).
#
# The admin CA certificate (PEM). Empty disables administration.
# compose.prod.yaml mounts TURNBACKS_ADMIN_CA (default ./ca/ca.crt) here itself.
TURNBACKS_ADMIN_CLIENT_CA=
# Header in which the TLS proxy forwards the client certificate: base64 DER
# (Caddy) or URL-encoded PEM (ingress-nginx: ssl-client-cert).
TURNBACKS_ADMIN_CERT_HEADER=X-Client-Cert
# Optional: only these certificate names (comma-separated) are administrators.
# Removing a name revokes that person.
TURNBACKS_ADMIN_NAMES=

# --- Identity (docs/identity.md) ------------------------------------------------
# ip: people are network addresses (one VPN address = one person).
# header: people are single sign-on users named by a header that an
#   authenticating proxy (oauth2-proxy, Pomerium, Authelia, Cloudflare Access…)
#   sets. Believed only from the proxy (Unix socket or TURNBACKS_TRUSTED_PROXIES);
#   the proxy must always overwrite it. Without the header: falls back to ip.
TURNBACKS_IDENTITY=ip
TURNBACKS_IDENTITY_USER_HEADER=X-Forwarded-Email
TURNBACKS_IDENTITY_GROUPS_HEADER=X-Forwarded-Groups
# How the groups header is split: "," (default), another separator, or "none"
# for one group per header line. If people can create groups whose names
# contain the separator, they could name one "x,turnbacks-admins": choose a
# separator your identity provider forbids, or use TURNBACKS_ADMIN_USERS.
TURNBACKS_IDENTITY_GROUPS_SEPARATOR=,
# Single sign-on administrators (header mode only), alongside certificates.
TURNBACKS_ADMIN_USERS=
TURNBACKS_ADMIN_GROUPS=

# --- Webhooks (docs/webhooks.md) ------------------------------------------------
# Outbound webhook URLs may not resolve to link-local addresses (cloud metadata);
# loopback is refused too unless this is true (development only).
TURNBACKS_WEBHOOK_ALLOW_LOOPBACK=false

# --- compose.prod.yaml (Caddy) ----------------------------------------------------
# Host name people use; Caddy serves HTTPS for it.
TURNBACKS_HOST=turnbacks.example.com
# Server certificate: internal (Caddy's local CA), an email address for ACME,
# or "/certs/tls.crt /certs/tls.key" (mount the files into the caddy service).
TURNBACKS_TLS=internal
# Path of the admin CA certificate on the Docker host.
TURNBACKS_ADMIN_CA=./ca/ca.crt
# Ports Caddy publishes on the host.
TURNBACKS_HTTP_PORT=80
TURNBACKS_HTTPS_PORT=443
# Image to run (both compose files build it as this name with --build).
TURNBACKS_IMAGE=turnbacks:latest

# --- compose.yaml (development) -------------------------------------------------
# Host ports, published on 127.0.0.1 only. `make dev` picks free ports itself.
TURNBACKS_DB_PORT=5432
TURNBACKS_APP_PORT=8080
# Development only (refused in production; `make dev` sets it): requests from
# this machine are administrators without a certificate.
# TURNBACKS_DEV_ADMIN_LOOPBACK=true
# Extra host names the Vite dev server accepts (tunnels), comma-separated.
# TURNBACKS_DEV_ALLOWED_HOSTS=dev.example.com,.mytunnel.dev

# --- Slack (optional, see docs/slack.md) -----------------------------------------
TURNBACKS_SLACK_SIGNING_SECRET=
# TURNBACKS_SLACK_SIGNING_SECRET_FILE=/run/secrets/slack-signing-secret
